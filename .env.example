# If you are ALREADY downloading with the upstream ClinFusion layout,
# point this at that repository's cache directory, e.g.:
# HOST_CACHE_DIR=/home/me/ClinFusion/cache
HOST_CACHE_DIR=./cache
HOST_DATA_DIR=./data

# Host API port. v3 keeps the working v2 default of 8008.
API_PORT=8008

# Active model. 8B is intentionally the default so upgrading/rerunning does not change behavior.
# Change with ./select-model.sh 32B when you are ready to test the larger model.
MODEL_VARIANT=8B

# Legacy/custom model-id setting from v2 is no longer required; the API derives
# clinfusion-8b or clinfusion-32b from MODEL_VARIANT.

# Leave blank for trusted/local testing. Set a strong value for LAN access.
# Both X-API-Key and Authorization: Bearer are accepted.
API_KEY=
CORS_ORIGINS=*

MODEL_AUTOLOAD=1
DEFAULT_MAX_NEW_TOKENS=128
MAX_NEW_TOKENS_LIMIT=4096
MAX_UPLOAD_MB=2048
MAX_IMAGES=10

# Strix Halo / ROCm defaults
CLINFUSION_DTYPE=fp16
CLINFUSION_ATTN_IMPL=sdpa
ATTENTION_BACKEND=TORCH_SDPA
CLINFUSION_STRICT_3D=1

# Optional Hugging Face token (not normally needed for these public repos)
HF_TOKEN=
HF_HUB_DOWNLOAD_TIMEOUT=60

# Pinned upstream versions used by this package
ROCM_IMAGE=rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1
CLINFUSION_REF=96dd208ea7cdfecd001a703e232aa607802a8fd6
